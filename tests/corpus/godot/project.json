{
  "name": "godot",
  "repo": "https://github.com/godotengine/godot.git",
  "tag": "4.5.1-stable",
  "commit": "f62fdbde15035c5576dad93e586201f4d41ef0cb",
  "license": "MIT",
  "support_dir": "platform/windows",
  "patch": "chameleon.patch",
  "args": [
    "--headless",
    "--editor",
    "--max-fps",
    "30",
    "--path",
    "{work}/godot_project"
  ],
  "env": {},
  "edits": [
    {
      "id": "os-windows-tu",
      "file": "platform/windows/os_windows.cpp",
      "replace": [
        {
          "find": "uint64_t OS_Windows::get_ticks_usec() const {\n",
          "with": "uint64_t OS_Windows::get_ticks_usec() const {\n\tcml_corpus_marker(\"godot_ticks_v2\");\n"
        }
      ],
      "expect": "markers=\\S*godot_ticks_v2:\\d+"
    },
    {
      "id": "windows-utils-tu",
      "file": "platform/windows/windows_utils.cpp",
      "replace": [
        {
          "find": "\tg_cml_corpus_utils_ticks = g_cml_corpus_utils_ticks + 1;\n",
          "with": "\tcml_corpus_marker(\"godot_utils_v2\");\n\tg_cml_corpus_utils_ticks = g_cml_corpus_utils_ticks + 1;\n"
        }
      ],
      "expect": "markers=\\S*godot_utils_v2:\\d+"
    },
    {
      "id": "header-inline-support",
      "file": "platform/windows/chameleon_corpus.h",
      "replace": [
        {
          "find": "    return 1;",
          "with": "    return 2;"
        }
      ],
      "expect": "inline=2 "
    },
    {
      "id": "template-support",
      "file": "platform/windows/chameleon_corpus.h",
      "replace": [
        {
          "find": "static_cast<T>(2)",
          "with": "static_cast<T>(3)"
        }
      ],
      "expect": "tmpl=64 "
    },
    {
      "id": "unsupported-new-thread-local",
      "file": "platform/windows/windows_utils.cpp",
      "replace": [
        {
          "find": "void cml_corpus_utils_frame(void) {\n",
          "with": "void cml_corpus_utils_frame(void) {\n\tstatic thread_local int cml_corpus_tls = 0;\n\tcml_corpus_tls++;\n"
        }
      ],
      "expect_error": "CML3400"
    },
    {
      "id": "static-lib-main",
      "file": "main/main.cpp",
      "replace": [
        {
          "find": "bool Main::iteration() {\n\titerating++;\n",
          "with": "bool Main::iteration() {\n\tcml_corpus_marker(\"godot_iteration_v2\");\n\titerating++;\n"
        }
      ],
      "include": "platform/windows/chameleon_corpus.h",
      "expect": "markers=\\S*godot_iteration_v2:\\d+",
      "final": true
    },
    {
      "id": "static-lib-scene-tree",
      "file": "scene/main/scene_tree.cpp",
      "replace": [
        {
          "find": "bool SceneTree::process(double p_time) {\n",
          "with": "bool SceneTree::process(double p_time) {\n\tcml_corpus_marker(\"godot_scenetree_process_v2\");\n"
        }
      ],
      "include": "platform/windows/chameleon_corpus.h",
      "expect": "markers=\\S*godot_scenetree_process_v2:\\d+",
      "final": true
    }
  ],
  "reload_timeout_s": 900,
  "observe_timeout_s": 120,
  "start_timeout_s": 600,
  "index_timeout_s": 1800,
  "min_functions": 50000,
  "expected_failures": [
    {
      "step": "edit:static-lib-main",
      "compiler": "*",
      "reason": "F-1: main/ is linked from a static library; its members are not source compilands, the reload patches nothing"
    },
    {
      "step": "edit:static-lib-scene-tree",
      "compiler": "*",
      "reason": "F-1: scene/ is linked from a static library; its members are not source compilands, the reload patches nothing"
    }
  ]
}