{
  "name": "raylib",
  "repo": "https://github.com/raysan5/raylib.git",
  "tag": "5.5",
  "commit": "c1ab645ca298a2801097931d1079b10ff7eb9df8",
  "license": "zlib",
  "support_dir": "src",
  "patch": "chameleon.patch",
  "args": [],
  "env": {
    "GALLIUM_DRIVER": "llvmpipe",
    "MESA_GL_VERSION_OVERRIDE": "3.3",
    "LIBGL_ALWAYS_SOFTWARE": "1"
  },
  "edits": [
    {
      "id": "game-function",
      "file": "examples/core/core_2d_camera_platformer.c",
      "replace": [
        {
          "find": "float delta)\n{\n    if (IsKeyDown(KEY_LEFT)) player->position.x -= PLAYER_HOR_SPD*delta;",
          "with": "float delta)\n{\n    cml_corpus_marker(\"plat_update_v2\");\n    if (IsKeyDown(KEY_LEFT)) player->position.x -= PLAYER_HOR_SPD*delta;"
        }
      ],
      "expect": "markers=\\S*plat_update_v2:\\d+"
    },
    {
      "id": "library-function",
      "file": "src/rcore.c",
      "replace": [
        {
          "find": "void EndDrawing(void)\n{\n    rlDrawRenderBatchActive();",
          "with": "void EndDrawing(void)\n{\n    cml_corpus_marker(\"rcore_enddrawing_v2\");\n    rlDrawRenderBatchActive();"
        }
      ],
      "include": "chameleon_corpus.h",
      "expect": "markers=\\S*rcore_enddrawing_v2:\\d+"
    },
    {
      "id": "header-inline-raymath",
      "file": "src/raymath.h",
      "replace": [
        {
          "find": "RMAPI float Clamp(float value, float min, float max)\n{\n    float result",
          "with": "RMAPI float Clamp(float value, float min, float max)\n{\n    cml_corpus_marker(\"raymath_clamp_v2\");\n    float result"
        }
      ],
      "include": "chameleon_corpus.h",
      "expect": "markers=\\S*raymath_clamp_v2:\\d+"
    },
    {
      "id": "header-inline-support",
      "file": "src/chameleon_corpus.h",
      "replace": [
        {
          "find": "    return 1;",
          "with": "    return 2;"
        }
      ],
      "expect": "inline=2 "
    },
    {
      "id": "template-support",
      "file": "src/chameleon_corpus.h",
      "replace": [
        {
          "find": "static_cast<T>(2)",
          "with": "static_cast<T>(3)"
        }
      ],
      "expect": "tmpl=64 "
    },
    {
      "id": "unsupported-new-thread-local",
      "file": "src/rshapes.c",
      "replace": [
        {
          "find": "void DrawPixel(int posX, int posY, Color color)\n{\n",
          "with": "void DrawPixel(int posX, int posY, Color color)\n{\n    static __declspec(thread) int cml_corpus_tls = 0;\n    cml_corpus_tls++;\n"
        }
      ],
      "expect_error": "CML3400"
    }
  ],
  "reload_timeout_s": 120,
  "observe_timeout_s": 30,
  "start_timeout_s": 90,
  "index_timeout_s": 300,
  "min_functions": 500,
  "expected_failures": []
}