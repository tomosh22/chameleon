{
  "name": "godot-gdextension",
  "base_project": "godot",
  "license": "MIT",
  "godot_cpp": {
    "repo": "https://github.com/godotengine/godot-cpp.git",
    "tag": "godot-4.5-stable",
    "commit": "e83fd0904c13356ed1d4c3d09f8bb9132bdc6b77",
    "license": "MIT"
  },
  "args": [
    "--headless",
    "--max-fps",
    "30",
    "--path",
    "{work}/gdext/project",
    "--script",
    "res://main.gd",
    "--",
    "--ctl={work}/gdext_ctl.txt"
  ],
  "env": {},
  "edits": [
    {
      "id": "plugin-load-lazily",
      "kind": "signal",
      "absent_before": "corpus_plugin\\.dll$",
      "write": { "file": "{work}/gdext_ctl.txt", "text": "loaded 1" },
      "expect": [
        "markers=\\S*plugin_init:1\\b",
        "markers=\\S*plugin_enabled_ok:1\\b"
      ],
      "wait_module": "corpus_plugin\\.dll$"
    },
    {
      "id": "plugin-function",
      "file": "../gdext/src/corpus_plugin.cpp",
      "replace": [
        {
          "find": "    corpus_plugin_marker(\"plugin_tick\");\n",
          "with": "    corpus_plugin_marker(\"plugin_tick\");\n    corpus_plugin_marker(\"plugin_tick_v2\");\n"
        }
      ],
      "expect": "markers=\\S*plugin_tick_v2:\\d+"
    },
    {
      "id": "host-calls-plugin",
      "file": "core/extension/gdextension.cpp",
      "replace": [
        {
          "find": "\t\tGDExtensionCallError ce{ GDEXTENSION_CALL_OK, 0, 0 };\n",
          "with": "\t\tcml_corpus_marker(\"godot_gdext_call_v2\");\n\t\tGDExtensionCallError ce{ GDEXTENSION_CALL_OK, 0, 0 };\n"
        }
      ],
      "include": "platform/windows/chameleon_corpus.h",
      "expect": "markers=\\S*godot_gdext_call_v2:\\d+"
    },
    {
      "id": "plugin-unload-load",
      "kind": "signal",
      "write": { "file": "{work}/gdext_ctl.txt", "text": "loaded 2" },
      "expect": [
        "markers=\\S*plugin_deinit:1\\b",
        "markers=\\S*plugin_init:2\\b",
        "markers=\\S*plugin_image_fresh:2\\b",
        "markers=\\S*plugin_enabled_ok:2\\b"
      ],
      "wait_module": "corpus_plugin\\.dll$"
    },
    {
      "id": "host-edit-after-plugin-reload",
      "kind": "check",
      "expect_grows": "godot_gdext_call_v2",
      "timeout_s": 30
    },
    {
      "id": "plugin-edit-survives-reload",
      "kind": "check",
      "expect_grows": "plugin_tick_v2",
      "timeout_s": 30
    },
    {
      "id": "plugin-function-after-reload",
      "file": "../gdext/src/corpus_plugin.cpp",
      "replace": [
        {
          "find": "    corpus_plugin_marker(\"plugin_tick\");\n",
          "with": "    corpus_plugin_marker(\"plugin_tick\");\n    corpus_plugin_marker(\"plugin_tick_v3\");\n"
        }
      ],
      "expect": "markers=\\S*plugin_tick_v3:\\d+"
    },
    {
      "id": "hot-restart-lazy-plugin",
      "kind": "restart",
      "write": { "file": "{work}/gdext_ctl.txt", "text": "keep" },
      "expect_diag": "CML5809",
      "expect_not_enabled": "corpus_plugin\\.dll$",
      "expect_reapplied": true
    },
    {
      "id": "plugin-load-after-restart",
      "kind": "signal",
      "absent_before": "corpus_plugin\\.dll$",
      "write": { "file": "{work}/gdext_ctl.txt", "text": "loaded 3" },
      "expect": [
        "markers=\\S*plugin_init:1\\b",
        "markers=\\S*plugin_enabled_ok:1\\b"
      ],
      "wait_module": "corpus_plugin\\.dll$"
    },
    {
      "id": "host-edit-reapplied-after-restart",
      "kind": "check",
      "expect_grows": "godot_gdext_call_v2",
      "timeout_s": 30
    },
    {
      "id": "plugin-edits-reapplied-after-restart",
      "kind": "check",
      "expect_grows": "plugin_tick_v2",
      "timeout_s": 30
    },
    {
      "id": "plugin-function-after-restart",
      "file": "../gdext/src/corpus_plugin.cpp",
      "replace": [
        {
          "find": "    corpus_plugin_marker(\"plugin_tick\");\n",
          "with": "    corpus_plugin_marker(\"plugin_tick\");\n    corpus_plugin_marker(\"plugin_tick_v4\");\n"
        }
      ],
      "expect": "markers=\\S*plugin_tick_v4:\\d+"
    }
  ],
  "reload_timeout_s": 900,
  "observe_timeout_s": 120,
  "start_timeout_s": 600,
  "index_timeout_s": 1800,
  "min_functions": 50000,
  "extra_modules": [
    { "file": "corpus_plugin.dll", "min_functions": 1000 }
  ],
  "expected_failures": [
    {
      "step": "check:plugin-edit-survives-reload",
      "compiler": "*",
      "match": "marker plugin_tick_v2 did not grow",
      "reason": "F-42.1: after FreeLibrary + LoadLibrary the plugin runs its original code; the broker drops the module's state and indexes the edited file as the new baseline, so the accepted edit is lost without a diagnostic (docs/wp/WP-42.md)"
    },
    {
      "step": "edit:plugin-function-after-reload",
      "compiler": "*",
      "match": "CML3350[\\s\\S]*LNK1104",
      "reason": "F-42.2: the first reload of the plugin after it was loaded again fails with CML3350 (LNK1104): the new module state numbers its patches from g1 again and patch_1_1.dll of the freed instance is still loaded from <session>/corpus_plugin.dll/p<pid>/g1 (docs/wp/WP-42.md)"
    },
    {
      "step": "check:plugin-edits-reapplied-after-restart",
      "compiler": "*",
      "match": "marker plugin_tick_v2 did not grow",
      "reason": "F-42.3: after a hot-restart the edits of a module the application enables late (CML5809) are not re-applied when it is enabled; the new process runs the plugin's original code and nothing says so (docs/wp/WP-42.md)"
    }
  ]
}
