# Configures tests/project for one case and checks the output (see ../CMakeLists.txt).
#   cmake -DSRC= -DWORK= -DCASE= -DMODULE= -DGENERATOR= [-DPLATFORM=] [-DCOMPILER=] [-DBUILD_TYPE=]
#         [-DEXPECT_FAILURE=1] [-DEXPECT_ID=<text that must appear>] [-DNOT_ID=<text that must not appear>] -P run_case.cmake
file(REMOVE_RECURSE "${WORK}")
set(args -S "${SRC}" -B "${WORK}" -G "${GENERATOR}" -DCASE=${CASE} -DCML_MODULE=${MODULE})
if(PLATFORM)
    list(APPEND args -A "${PLATFORM}")
endif()
if(NOT GENERATOR MATCHES "Visual Studio")
    list(APPEND args "-DCMAKE_CXX_COMPILER=${COMPILER}")
endif()
if(CASE STREQUAL "release_build")
    list(APPEND args -DCMAKE_BUILD_TYPE=Release)
elseif(BUILD_TYPE MATCHES "^(Debug|RelWithDebInfo)$")
    list(APPEND args -DCMAKE_BUILD_TYPE=${BUILD_TYPE})
else()
    # The outer build may be empty, Release or MinSizeRel; every case but release_build needs a supported type.
    list(APPEND args -DCMAKE_BUILD_TYPE=Debug)
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" ${args} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
message(STATUS "configure exit code ${rc}")
message(STATUS "stdout: ${out}")
message(STATUS "stderr: ${err}")
set(all "${out} ${err}")
string(REGEX REPLACE "[ \r\n]+" " " all "${all}")  # CMake wraps long messages
if(EXPECT_FAILURE)
    if(rc EQUAL 0)
        message(FATAL_ERROR "case ${CASE}: the configure was expected to fail but succeeded")
    endif()
elseif(NOT rc EQUAL 0)
    message(FATAL_ERROR "case ${CASE}: the configure failed (exit code ${rc})")
endif()
if(EXPECT_ID AND NOT all MATCHES "${EXPECT_ID}")
    message(FATAL_ERROR "case ${CASE}: expected ${EXPECT_ID} in the output")
endif()
if(NOT_ID AND all MATCHES "${NOT_ID}")
    message(FATAL_ERROR "case ${CASE}: ${NOT_ID} must not appear in the output")
endif()
if(EXPECT_ID AND NOT all MATCHES "What to do:")
    message(FATAL_ERROR "case ${CASE}: the message has no 'What to do:' sentence")
endif()
message(STATUS "case ${CASE}: ok")
